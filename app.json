
{
  "expo": {
    "name": "Music Player",
    "slug": "android-music-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.example.androidmusicplayer",
      "permissions": [
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "granularPermissions": ["audio"]
        }
      ]
    ]
  }
}
